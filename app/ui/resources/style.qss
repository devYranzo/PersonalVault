QMainWindow {
    background: #f5f6f8;
}

QWidget {
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
    color: #1f2329;
}

QFrame#sidebar {
    background: #1f2329;
}

QLabel#appTitle {
    color: white;
    font-size: 21px;
    font-weight: 700;
}

QLabel#appSubtitle {
    color: #9da4ae;
    font-size: 12px;
}

QLabel#sidebarStatus {
    color: #6f7782;
    font-size: 11px;
}

QPushButton#navButton {
    background: transparent;
    color: #c9ced6;
    border: none;
    border-radius: 8px;
    padding: 10px 12px;
    text-align: left;
}

QPushButton#navButton:hover {
    background: #2b3038;
    color: white;
}

QPushButton#navButton:checked {
    background: #3a414c;
    color: white;
    font-weight: 600;
}

QLabel#pageTitle {
    color: #1f2329;
    font-size: 30px;
    font-weight: 700;
}

QLabel#pageDescription {
    color: #69717d;
    font-size: 15px;
    max-width: 700px;
}

QLabel#dashboardStats {
    color: #1f2329;
    background: white;
    border: 1px solid #e1e4e8;
    border-radius: 10px;
    padding: 18px;
    font-size: 15px;
}

QLabel#taskItem {
    color: #1f2329;
    background: white;
    border: 1px solid #e1e4e8;
    border-radius: 10px;
    padding: 14px;
}

QLabel#documentItem {
    color: #1f2329;
    background: white;
    border: 1px solid #e1e4e8;
    border-radius: 10px;
    padding: 14px;
}

/* ============================================================
   BOTONES (genéricos)
   Cualquier QPushButton con la propiedad "variant" toma este estilo.
   Variantes: primary | secondary | danger
   El icono de IconButton se tiñe con el "color" definido aquí.
   ============================================================ */

QPushButton[variant] {
    background: #ffffff;
    color: #1f2329;
    border: 1px solid #d5d9df;
    border-radius: 6px;
    padding: 7px 14px;
    font-weight: 500;
}

QPushButton[variant]:hover {
    background: #f3f4f6;
    border-color: #b8bec7;
}

QPushButton[variant]:pressed {
    background: #e8eaed;
}

QPushButton[variant]:disabled {
    background: #f3f4f6;
    color: #b0b6bf;
    border-color: #e5e7eb;
}

QPushButton[variant="primary"] {
    background: #1f2329;
    color: #ffffff;
    border-color: #1f2329;
}

QPushButton[variant="primary"]:hover {
    background: #343b45;
    border-color: #343b45;
}

QPushButton[variant="primary"]:pressed {
    background: #14171b;
}

QPushButton[variant="primary"]:disabled {
    background: #e5e7eb;
    color: #9ca3af;
    border-color: #e5e7eb;
}

QPushButton[variant="danger"] {
    background: #ffffff;
    color: #b42318;
    border-color: #e5c4c0;
}

QPushButton[variant="danger"]:hover {
    background: #fdf3f2;
    border-color: #d99a94;
}

QPushButton[variant="danger"]:pressed {
    background: #fbe4e1;
}

QPushButton[variant="danger"]:disabled {
    background: #f3f4f6;
    color: #c9a5a1;
    border-color: #e5e7eb;
}

/* ============================================================
   CONEXIONES
   ============================================================ */

QScrollArea#pageScroll {
    background: transparent;
    border: none;
}

QScrollArea#pageScroll > QWidget > QWidget {
    background: transparent;
}

QWidget#pageContainer {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #cdd1d7;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #9ca3af;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

QLabel#pageSummary {
    color: #8a919c;
    font-size: 13px;
}

/* --- Estado vacío ------------------------------------------ */
QFrame#emptyState {
    background: transparent;
    border: 1px dashed #c7cbd1;
    border-radius: 10px;
}

QLabel#emptyTitle {
    font-size: 16px;
    font-weight: 600;
}

QLabel#emptyHint {
    color: #8a919c;
    font-size: 13px;
}

/* --- Tarjeta de plugin ------------------------------------- */
QFrame#pluginCard {
    background: white;
    border: 1px solid #e3e5e9;
    border-radius: 10px;
}

QFrame#pluginCard:hover {
    border-color: #c4c9d0;
}

QLabel#pluginAvatar {
    background: #eef0f3;
    color: #3a414c;
    border-radius: 8px;
    font-size: 17px;
    font-weight: 600;
}

QLabel#pluginName {
    color: #1f2329;
    font-size: 16px;
    font-weight: 600;
}

QLabel#pluginVersion {
    color: #8a919c;
    font-size: 12px;
}

QLabel#pluginDescription {
    color: #4b5563;
    font-size: 13px;
}

QLabel#capabilityText {
    color: #6b7380;
    font-size: 12px;
}

/* Estado: punto + texto */
QLabel#statusDot {
    background: #b8bec7;
    border-radius: 4px;
}

QLabel#statusDot[state="enabled"]    { background: #22a559; }
QLabel#statusDot[state="error"]      { background: #d92d20; }
QLabel#statusDot[state="discovered"] { background: #e0a100; }
QLabel#statusDot[state="disabled"]   { background: #b8bec7; }

QLabel#pluginStatus {
    color: #6b7380;
    font-size: 12px;
}

QFrame#pluginError {
    background: #fdf3f2;
    border: 1px solid #f0cfcb;
    border-radius: 6px;
}

QLabel#pluginErrorText {
    color: #b42318;
    font-size: 13px;
}

/* ============================================================
   DASHBOARD
   ============================================================ */

QLabel#sectionTitle {
    color: #1f2329;
    font-size: 14px;
    font-weight: 600;
}

QFrame#statCard {
    background: white;
    border: 1px solid #e3e5e9;
    border-radius: 10px;
}

QFrame#statCard:hover {
    border-color: #c4c9d0;
}

QLabel#statIcon {
    background: #eef0f3;
    border-radius: 8px;
}

QLabel#statNumber {
    color: #1f2329;
    font-size: 30px;
    font-weight: 700;
}

QLabel#statLabel {
    color: #4b5563;
    font-size: 13px;
    font-weight: 500;
}

QLabel#statHint {
    color: #8a919c;
    font-size: 12px;
}

QLabel#dashboardError {
    color: #b42318;
    background: #fdf3f2;
    border: 1px solid #f0cfcb;
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 13px;
}

/* ============================================================
   FILTROS SEGMENTADOS (genérico: QPushButton con variant="segment",
   checkable). Va después de los botones genéricos para ganar prioridad.
   ============================================================ */

QPushButton[variant="segment"] {
    background: transparent;
    color: #6b7380;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton[variant="segment"]:hover {
    background: #eceef1;
    color: #1f2329;
    border-color: transparent;
}

QPushButton[variant="segment"]:pressed {
    background: #e3e5e9;
}

QPushButton[variant="segment"]:checked {
    background: white;
    color: #1f2329;
    border-color: #d5d9df;
}

QPushButton[variant="segment"]:checked:hover {
    background: white;
    border-color: #b8bec7;
}

/* ============================================================
   TAREAS
   ============================================================ */

QFrame#taskRow {
    background: white;
    border: 1px solid #e3e5e9;
    border-radius: 10px;
}

QFrame#taskRow:hover {
    border-color: #c4c9d0;
}

QLabel#taskTitle {
    color: #1f2329;
    font-size: 15px;
    font-weight: 600;
}

QLabel#taskTitle[state="completed"] {
    color: #8a919c;
}

QLabel#taskMeta {
    color: #6b7380;
    font-size: 12px;
}

QLabel#taskMeta[state="overdue"] {
    color: #b42318;
    font-weight: 600;
}

QLabel#taskDescription {
    color: #4b5563;
    font-size: 13px;
}

QLabel#taskStatus {
    font-size: 12px;
    font-weight: 600;
    color: #6b7380;
}

QLabel#taskStatus[state="in_progress"] { color: #a16207; }
QLabel#taskStatus[state="completed"]   { color: #1a8a4a; }
QLabel#taskStatus[state="overdue"]     { color: #b42318; }

/* ============================================================
   CALENDARIO
   ============================================================ */

QLabel#calendarMonth {
    color: #1f2329;
    font-size: 20px;
    font-weight: 600;
}

QLabel#calendarWeekday {
    color: #8a919c;
    font-size: 12px;
    font-weight: 600;
    padding-bottom: 2px;
}

QFrame#dayCell {
    background: white;
    border: 1px solid #e3e5e9;
    border-radius: 8px;
}

QFrame#dayCell:hover {
    border-color: #b8bec7;
}

QFrame#dayCell[outside="true"] {
    background: transparent;
    border-color: #eceef1;
}

QFrame#dayCell[selected="true"] {
    border-color: #1f2329;
}

QLabel#dayNumber {
    color: #374151;
    font-size: 13px;
    font-weight: 500;
}

QLabel#dayNumber[outside="true"] {
    color: #b0b6bf;
}

QLabel#dayNumber[today="true"] {
    background: #1f2329;
    color: white;
    border-radius: 11px;
    font-weight: 600;
}

QLabel#calendarDot {
    border-radius: 3px;
    background: #3a414c;
}

QLabel#calendarDot[kind="done"]    { background: #b8bec7; }
QLabel#calendarDot[kind="overdue"] { background: #d92d20; }
QLabel#calendarDot[kind="event"]   { background: #0e8a9a; }

QLabel#calendarMore {
    color: #8a919c;
    font-size: 11px;
}

QLabel#calendarLegend {
    color: #8a919c;
    font-size: 12px;
}

/* Panel del día */
QFrame#calendarPanel {
    background: white;
    border: 1px solid #e3e5e9;
    border-radius: 10px;
}

QLabel#panelTitle {
    color: #1f2329;
    font-size: 16px;
    font-weight: 600;
}

QLabel#panelSubtitle {
    color: #8a919c;
    font-size: 12px;
}

QFrame#calendarItem {
    background: #f7f8fa;
    border: 1px solid #eceef1;
    border-radius: 8px;
}

QLabel#calendarItemTitle {
    color: #1f2329;
    font-size: 13px;
    font-weight: 600;
}

QLabel#calendarItemMeta {
    color: #6b7380;
    font-size: 12px;
}

/* Botones solo-icono (cualquier variante): sin padding horizontal */
QPushButton[variant][iconOnly="true"] {
    padding: 0;
}
